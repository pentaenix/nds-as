.venv/
__pycache__/
*.pyc
.DS_Store
/dist/
/build/
*.egg-info/
preview_output/
extracted_assets/
converted_glb/

# ROM dumps — never commit game files (keeps folder placeholders only)
roms/**
!roms/README.md
!roms/.gitkeep

# Exported / converted assets — local output only
exports/**
!exports/README.md
!exports/.gitkeep

saves/*
!saves/README.md
!saves/.gitkeep

# EasyFind indexes — local build artifacts (one file per DS game code)
easyfind/**
!easyfind/README.md
!easyfind/.gitkeep
easyfind/*.tmp
easyfind/*.easyfind.tmp

# Texture dictionary indexes — one cache file per DS game code (local only)
texture_index/**
!texture_index/README.md
!texture_index/.gitkeep
texture_index/*.texture-index.tmp

# Vendored apicula — source is tracked; Rust build output stays local
tools/apicula/target/
# Oodle decompression (download from WorkingRobot/OodleUE; not redistributable)
tools/liboo2core*.dylib
tools/oo2core_*.dll
/.cache
