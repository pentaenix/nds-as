{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pentaenix/rae/mappings/schema.json",
  "title": "RAE community mapping schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "mappingId",
    "gameFamily",
    "games",
    "sources",
    "archives"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "mappingId": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": ["nds", "gba", "gbc", "gb", "3ds"],
      "description": "Console this mapping applies to. Defaults to the parent folder name."
    },
    "gameFamily": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "archiveAliases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scanHints": {
      "type": "array",
      "description": "Optional scan-time hints. These guide discovery only; they do not label assets after they are found.",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "scanMode": {
            "type": "string",
            "enum": ["normal", "carve", "deep", "deep-carve"]
          },
          "expectedMagics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decompressors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxDepth": {
            "type": "integer"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uiGroups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decoderHints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "searchPresets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "workflow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
