  "decoderHints": [
    {
      "format": "NARC",
      "role": "container",
      "notes": "Parse and index child files lazily."
    },
    {
      "format": "BMD0/NSBMD",
      "role": "3d-model",
      "notes": "May embed textures or reference external BTX0/NSBTX texture/palette data."
    },
    {
      "format": "BTX0/NSBTX",
      "role": "3d-texture-pack",
      "notes": "Decode texture entries and palettes to PNG; use names to match model materials."
    },
    {
      "format": "RGCN/NCGR",
      "role": "2d-tile-graphics",
      "notes": "Needs NCLR palette and often NSCR/NCER layout for meaningful preview."
    },
    {
      "format": "RLCN/NCLR",
      "role": "palette",
      "notes": "Pair with NCGR/NSCR/NCER/NANR where possible."
    },
    {
      "format": "RCSN/NSCR",
      "role": "tilemap",
      "notes": "Pair with NCGR and NCLR."
    },
    {
      "format": "RECN/NCER",
      "role": "sprite-cells",
      "notes": "Pair with NCGR, NCLR, and optionally NANR."
    },
    {
      "format": "RNAN/NANR",
      "role": "sprite-animation",
      "notes": "Pair with NCER/NCGR/NCLR."
    }
  ],
  "searchPresets": [
    {
      "id": "battle_move_effects",
      "label": "Battle move effects / grass sprite hunt",
      "query": "cat:move-effects|cat:move-animations|path:wazaeffect|path:a/0/2/2|path:a/0/2/3|path:a/0/2/4|path:a/0/2/5|path:a/0/2/9|path:a/0/6/6",
      "description": "Start here for move VFX such as grass/leaves/vines: tiles/graphics, palettes, cell layouts, cell animations, particles, and move animation scripts.",
      "workflow": [
        "Filter shows the known move-effect archives first.",
        "Open tile/texture rows (NCGR/RGCN/BTX0) and use Export Readable to create PNG/contact sheets.",
        "Open palette rows (NCLR/RLCN) beside them and export swatches.",
        "Open cell/cell-animation rows (NCER/RECN and NANR/RNAN) as raw exports until NDS-AS can fully compose those animations.",
        "For Gen 5, move animation scripts are often separate from the sprite graphics, so search scripts and visual archives together."
      ]
    },
    {
      "id": "battle_assets",
      "label": "Battle assets",
      "query": "cat:battle|cat:battle-textures|cat:move-effects|cat:move-animations|label:battle|path:battle|path:waza|path:a/0/1/1|path:a/0/6/6",
      "description": "Battle backgrounds, battle UI/objects, move-effect graphics, and animation/script candidates.",
      "workflow": [
        "Use this when you know the asset appears in battle but do not know if it is a sprite, background, texture, or script."
      ]
    },
    {
      "id": "models_with_textures",
      "label": "Models + likely textures",
      "query": "magic:BMD0|magic:BTX0|cat:models|cat:textures|cat:model-metadata|cat:map-relations",
      "description": "Show models, texture packs, and mapping/area relation archives used to bind models to textures.",
      "workflow": [
        "Click BMD0 for model preview. If gray, select a BTX0 from the same mapped group and Use Selected BTX0."
      ]
    },
    {
      "id": "music_sfx",
      "label": "Music / SFX",
      "query": "cat:audio|magic:SDAT|magic:SSEQ|magic:SSAR|magic:SBNK|magic:SWAR|magic:SWAV|magic:STRM",
      "description": "Sound archives, sequence music, SFX archives, banks, wave archives, samples, and streams.",
      "workflow": [
        "Use Export Readable for a lossless audio bundle and WAV previews when NDS-AS can decode sample/stream data."
      ]
    }
  ]
