    }
  ],
  "pathIdRules": [
    {
      "id": "pm_form",
      "pattern": "pm{num:4d}_{formA:2d}_{formB:2d}",
      "speciesField": "num",
      "description": "Primary HOME Pokémon model id used in pokemons/ and dependencies/ trees."
    },
    {
      "id": "cap_cache",
      "pattern": "cap{num:4d}_f{form:2d}_s{shader}",
      "speciesField": "num",
      "description": "On-device tyranitar cache encrypted bundles; num is National Dex."
    },
    {
      "id": "mitake_preview",
      "pattern": "mt_pv_ev_{num:4d}_{formA:2d}_{formB:2d}",
      "speciesField": "num",
      "description": "Mitake preview / evolution encrypted bundles."
    }
  ],
